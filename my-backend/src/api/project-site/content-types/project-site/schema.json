{
  "kind": "collectionType",
  "collectionName": "project_sites",
  "info": {
    "singularName": "project-site",
    "pluralName": "project-sites",
    "displayName": "ProjectSite"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "location": {
      "type": "text"
    },
    "withdrawal_requests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::withdrawal-request.withdrawal-request",
      "mappedBy": "project_site"
    },
    "project_status": {
      "type": "enumeration",
      "default": "active",
      "enum": [
        "active",
        "closed",
        "pending"
      ]
    },
    "return_requests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::return-request.return-request",
      "mappedBy": "project_site"
    },
    "coordinates": {
      "type": "string"
    },
    "distance_from_branch": {
      "type": "string"
    },
    "overall_progress": {
      "type": "integer"
    },
    "jobs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::job.job",
      "mappedBy": "project_site"
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer",
      "inversedBy": "project_sites"
    },
    "checkin_GPS": {
      "type": "json"
    },
    "daily_reports": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::daily-report.daily-report",
      "mappedBy": "project_site"
    },
    "checklists": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::checklist.checklist",
      "mappedBy": "project_site"
    },
    "team_members": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "project_sites"
    },
    "start_date": {
      "type": "date"
    },
    "end_date": {
      "type": "date"
    }
  }
}
