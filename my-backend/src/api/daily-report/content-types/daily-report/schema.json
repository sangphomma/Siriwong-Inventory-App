{
  "kind": "collectionType",
  "collectionName": "daily_reports",
  "info": {
    "singularName": "daily-report",
    "pluralName": "daily-reports",
    "displayName": "DailyReport"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "report_date": {
      "type": "date"
    },
    "title": {
      "type": "string"
    },
    "work_description": {
      "type": "text"
    },
    "problem_note": {
      "type": "text"
    },
    "work_status": {
      "type": "enumeration",
      "enum": [
        "Normal",
        "Caution",
        "Problem",
        "Done"
      ]
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "project_site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project-site.project-site",
      "inversedBy": "daily_reports"
    }
  }
}
